__pycache__/
*.pyc
.venv/
.ruff_cache/
*.egg-info/
uv.lock

# Everything the server writes while it runs: generated scenes, cards, zips, logs,
# and the cache of images pulled from the bucket.
run/

# The renders themselves - 700 MB, and about 900 model calls to make again. They live
# in S3 and are fetched on demand by layoutgen/assets.py, so a clone is a few MB and
# still shows every page. The scores, runs and routing picks under results/ ARE
# committed: they are small, and they are what the pages are actually built from.
results/scenes/
results/thumbs/

# The viewers and the flat export, which are built from the data beside them: 22 MB
# between them, and `tools/build_*.py` remakes any one in seconds. The pages under
# `site/` are committed because they are the published ones; these are local review.
results/*.html
results/pipeline_export.csv

# A spec set kept beside the current one while two pipeline versions were compared.
# Scratch by construction - the version hash names it, and the specs in use are the
# ones in `results/routing/blob`.
results/routing/_*/

# Credentials never belong here. The image and text models read a key from
# ~/.cache/i2l/ or the environment; AWS reads ~/.aws/credentials.
.env
.env.*
*.pem
*.key
credentials
*_token
